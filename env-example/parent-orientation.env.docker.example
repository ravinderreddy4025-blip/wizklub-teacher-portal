# Optional: used with docker compose when you add `env_file: .env.docker` to the app service.
# Copy to .env.docker (do not commit).
#
# Root `docker-compose.yml` runs PMO with NODE_ENV=production by default. Use passwords that pass
# production validation (12+ chars, not weak defaults, PMO_PASS ≠ SPEAKER_PASS).

BIND_HOST=0.0.0.0
PORT=8080
NODE_ENV=production

COOKIE_SECRET=docker-compose-local-dev-32char-secret-change-me
PMO_USER=PMO
PMO_PASS=PMO-docker-example-password-12
SPEAKER_USER=Speaker
SPEAKER_PASS=Speaker-docker-example-password-12
ADMIN_USER=admin

# Compose service name from root docker-compose.yml
MONGODB_URI=mongodb://po-mongo:27017/
MONGODB_DB=parent_orientation

# Swagger: leave unset in production. Local only:
# SWAGGER_UI=0
