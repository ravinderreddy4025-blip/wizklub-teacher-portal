# Frontend environment example — copy to frontend/technathon/.env
# With root docker-compose (gateway), the browser calls same-origin /technathon/api/ so VITE_API_URL is often empty.

VITE_API_URL=
# VITE_API_URL=http://localhost:5000

# Must match how the app is hosted (see vite.config / Dockerfile build args)
# VITE_APP_BASE_PATH=/technathon/
