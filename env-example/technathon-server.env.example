# ── Environment Template for Technathon ───────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

PORT=5000
NODE_ENV=production
# Production checklist (when NODE_ENV=production):
# - JWT_SECRET: >= 32 chars, not a test_* value
# - MONGO_URI: mongodb://... or mongodb+srv://...
# - ALLOWED_ORIGIN + PUBLIC_WEB_ORIGIN: real browser-facing URLs (see CORS section)
# - TRUST_PROXY=true when behind nginx / a load balancer (see below)
# Socket timeouts for large S3 uploads (ms). Default 900000 (15 min).
# S3_UPLOAD_TIMEOUT_MS=900000

# ── MongoDB ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/technathon
# For Docker (root compose): mongodb://technathon-mongo:27017/technathon

# ── AWS S3 Upload Storage ──────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your_bucket_name
# Optional: override public URL base if using CloudFront/custom domain.
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: object key prefix inside the bucket.
# S3_UPLOAD_PREFIX=technathon
# Signed URL expiry in seconds (AWS S3 max is 604800 = 7 days)
# S3_SIGNED_URL_EXPIRES_SEC=604800
# ── AWS SES email notifications (submission submit/edit) ─────
# SES_REGION defaults to AWS_REGION if omitted
# SES_REGION=ap-south-1
# SES_FROM_EMAIL=no-reply@yourdomain.com
# Optional: dedicated SES credentials (use when main AWS keys cannot send SES)
# AWS_NOTIF_ACCESS_KEY=your_ses_access_key
# AWS_NOTIF_SECRET_KEY=your_ses_secret_key
# AWS_NOTIF_SESSION_TOKEN=your_temp_session_token
# (or SES_ACCESS_KEY_ID / SES_SECRET_ACCESS_KEY / SES_SESSION_TOKEN)
# Logo in the SES student email (<img src>). Email clients only load public URLs (not localhost / VPN).
# Option A — public HTTPS URL (PNG/JPG recommended; avoid http-only or auth-protected URLs):
# WIZKLUB_LOGO_URL=https://your-cdn.example.com/wizklub-logo.png
# Option B — file on the API server, inlined as data URI (works without a CDN; max ~120 KB; PNG/JPG best):
# WIZKLUB_LOGO_PATH=./assets/email-logo.png
# If neither is set, a small public favicon URL is used (may look tiny in mail clients).
# Optional: template name in SES (default WIZ_TECHNATHON_STUDENT_SUBMISSION_CONFIRMATION)
# SES_STUDENT_SUBMISSION_TEMPLATE_NAME=WIZ_TECHNATHON_STUDENT_SUBMISSION_CONFIRMATION
# Optional reply-to mailbox:
# SES_REPLY_TO_EMAIL=support@yourdomain.com
# Outbound upload timeout (ms). Default 900000 (15m).
# S3_UPLOAD_TIMEOUT_MS=900000

# ── Admin Auth ─────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate hash: node scripts/generate-hash.js YourStrongPassword
ADMIN_PASSWORD_HASH=

# ── JWT ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────
# Production: set to your real HTTPS origin(s). Comma-separate multiple (no spaces required).
# Example: https://technathon.wizklub.com,https://www.wizklub.com
ALLOWED_ORIGIN=http://localhost:5174

# Behind reverse proxy (nginx / ALB) — set so client IP and rate limits are correct
# TRUST_PROXY=true

# ── Signed student form links (required in production / local dev) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_FORM_SECRET=
# Base URL students open (used when admin generates links). Docker web default: http://localhost:5174
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Unified gateway (subpath) example — may include a path; student links use it as-is:
# PUBLIC_WEB_ORIGIN=http://localhost:8080/technathon
# Admin flow: POST /api/admin/roster/import (.xlsx: school, student name, admission no. optional, username, grade), then POST /api/admin/student-links with usernames — links persist on roster rows in Mongo (or in-memory in test).

# ── Rate limiting (optional tuning) ─────────────────────────
# Jest bypasses limits unless ENABLE_RATE_LIMIT_IN_TEST=true
# For preprod load testing only — re-enable before public launch:
# DISABLE_RATE_LIMIT=true
#
# API (submissions/export): defaults 300 req / 60s / IP
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=300
#
# Login: defaults 5 / 15min / IP
# LOGIN_RATE_LIMIT_MAX=5
#
# Upload: defaults 30 / 15min / IP
# UPLOAD_LIMIT_WINDOW_MS=900000
# UPLOAD_LIMIT_MAX=30
