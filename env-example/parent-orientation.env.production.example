# Production template — copy to `.env` on the server (never commit `.env`).
# Use strong secrets, HTTPS via a reverse proxy, and MongoDB TLS where available.
# Start: npm run start:prod   OR   NODE_ENV=production node backend/server.js

NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=8080

# Required: 32+ random bytes (openssl rand -base64 32). Rotating this logs everyone out.
COOKIE_SECRET=

# Required: 12+ characters each, not equal, not common defaults
PMO_USER=PMO
PMO_PASS=
SPEAKER_USER=Speaker
SPEAKER_PASS=

# Optional: second username for PMO role (uses PMO_PASS, not a separate password)
ADMIN_USER=admin

# Required in production (shared state). Use TLS to Mongo if your provider supports it.
MONGODB_URI=
# MONGODB_DB=parent_orientation

# Behind nginx / TLS termination
TRUST_PROXY=1
COOKIE_SECURE=1

# OpenAPI/Swagger: leave SWAGGER_UI unset for normal production (no /api-docs, no /openapi.json).
# Never set the line below on an internet-facing server. Private bastion / jump host only:
# SWAGGER_UI=1

# Post-deploy: curl -sS https://your-host/api/health (or your monitoring tool)

# Optional tuning
# RATE_LIMIT_LOGIN_MAX=15
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_API_MAX=400
