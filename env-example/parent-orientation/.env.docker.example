# Optional: used with docker compose when you add `env_file: .env.docker` to the app service.
# Copy to .env.docker (do not commit).

BIND_HOST=0.0.0.0
PORT=8080
NODE_ENV=development

COOKIE_SECRET=docker-compose-local-dev-32char-secret-change-me
PMO_USER=PMO
PMO_PASS=PMO@123
SPEAKER_USER=Speaker
SPEAKER_PASS=Speaker@123
ADMIN_USER=admin

# Compose service name from docker-compose.yml
MONGODB_URI=mongodb://mongo:27017/
MONGODB_DB=parent_orientation

# Optional: with NODE_ENV=development, Swagger is on unless you set:
# SWAGGER_UI=0
# Production container: omit SWAGGER_UI (do not set SWAGGER_UI=1 on public URLs).

