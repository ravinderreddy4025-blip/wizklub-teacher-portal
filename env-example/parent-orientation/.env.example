# Copy to .env and fill in real values. Never commit .env.
# Templates: `.env.production.example` (prod), `.env.preprod.example` (staging / preprod)
# Docker (optional): `.env.docker.example` for compose overrides

PORT=8080
BIND_HOST=127.0.0.1

# Local dev: defaults below are fine. Production: see .env.production.example
# (NODE_ENV=production enforces strong COOKIE_SECRET, passwords 12+ chars, MONGODB_URI, etc.)
# 32+ chars; cannot be "replace-with-long-random*" or "dev-change-me*". For real deploys: openssl rand -base64 32
COOKIE_SECRET=local-dev-only-use-openssl-rand-for-production-32chars
PMO_USER=PMO
PMO_PASS=PMO@123
SPEAKER_USER=Speaker
SPEAKER_PASS=Speaker@123
ADMIN_USER=admin

# If the app URL is http:// (not https://)—e.g. opening via PC LAN IP or phone—set COOKIE_SECURE=0
# or the browser will drop the session cookie and login / save / load will all fail.
# COOKIE_SECURE=0

# MongoDB — optional locally; required when NODE_ENV=production
# MONGODB_DB=parent_orientation
# MONGODB_URI=mongodb://USER:PASSWORD@172.21.21.196/?directConnection=true&authSource=admin
# MONGODB_DISABLED=1   # optional: run without Mongo (sessions only in browser) if the DB is unreachable

# --- Preprod / server ---
# BIND_HOST=0.0.0.0
# TRUST_PROXY=1
# COOKIE_SECURE=1
# NODE_ENV=production
#
# API docs: dev = on unless SWAGGER_UI=0; production = off unless SWAGGER_UI=1
# SWAGGER_UI=0
# SWAGGER_UI=1


# Optional rate limits (public production tuning)
# RATE_LIMIT_LOGIN_MAX=15
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_API_MAX=400
