# Preprod / staging — copy to `.env` on the preprod host (never commit `.env`).
# The app treats preprod like production: NODE_ENV=production (strict secrets, Mongo required).

NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=8080

# openssl rand -base64 32   (use a value different from production)
COOKIE_SECRET=

PMO_USER=PMO
PMO_PASS=
SPEAKER_USER=Speaker
SPEAKER_PASS=
ADMIN_USER=admin

# Preprod MongoDB (separate cluster or same cluster with different DB name)
MONGODB_URI=
# Use a dedicated DB so you never touch production data:
MONGODB_DB=parent_orientation_preprod

# nginx / load balancer in front of Node
TRUST_PROXY=1
COOKIE_SECURE=1

# Preprod uses NODE_ENV=production — docs are off unless you set SWAGGER_UI=1 (private QA only).

# Optional: relax limits while QA hammers the UI
# RATE_LIMIT_API_MAX=800
# RATE_LIMIT_LOGIN_MAX=30

# --- Only if you must test over HTTP (lab VPN, never public internet) ---
# COOKIE_SECURE=0
