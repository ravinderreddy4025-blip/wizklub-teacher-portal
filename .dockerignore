# Used only when the Docker build context is the repository root (e.g. `docker build .`).
# Per-service builds (backend/*/frontend/*) still use each folder’s own .dockerignore.

.git
**/.env
**/.env.*
**/.env.local
**/node_modules
**/dist
**/build
**/coverage
**/.DS_Store
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
backend/health-snapshot/raw
backend/health-snapshot/out
**/health-snapshot/raw/**
**/health-snapshot/out/**
**/__pycache__
