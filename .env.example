# ============================================================================
# Shared environment file for BOTH projects in this repository:
# - Technathon backend (`backend/technathon`)
# - Parent Orientation / PMO backend (`backend/parent-orientation`)
#
# Copy this file to `.env` and fill real values.
# ============================================================================

# ----------------------------------------------------------------------------
# Common / Compose-level overrides
# ----------------------------------------------------------------------------
PMO_NODE_ENV=production
# One shared Mongo host/cluster URI for both apps.
MONGO_URI=mongodb://<username>:<password>@<mongo-host>:27017/?authSource=admin
# Two app DB names on the same Mongo host.
TECH_MONGO_DB_NAME=technathon
PMO_MONGO_DB_NAME=parent_orientation

# ----------------------------------------------------------------------------
# Technathon backend
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# AWS S3 storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_UPLOAD_PREFIX=technathon
S3_SIGNED_URL_EXPIRES_SEC=604800

# SES email notifications
SES_REGION=ap-south-1
SES_FROM_EMAIL=donotreply@yourdomain.com
AWS_NOTIF_ACCESS_KEY=your_ses_access_key
AWS_NOTIF_SECRET_KEY=your_ses_secret_key
SES_STUDENT_SUBMISSION_TEMPLATE_NAME=WIZ_TECHNATHON_STUDENT_SUBMISSION_CONFIRMATION
WIZKLUB_LOGO_PATH=./assets/email-logo.png
# SES_REPLY_TO_EMAIL=
# S3_PUBLIC_BASE_URL=

# Admin auth
ADMIN_USERNAME=admin
# Generate hash: node backend/technathon/scripts/generate-hash.js YourStrongPassword
ADMIN_PASSWORD_HASH='$2a$12$replace_with_real_bcrypt_hash'

# JWT / signed links
JWT_SECRET=replace_with_strong_random_secret
STUDENT_FORM_SECRET=replace_with_strong_random_secret

# Browser origins
ALLOWED_ORIGIN=http://localhost:8080
PUBLIC_WEB_ORIGIN=http://localhost:8080/technathon

# ----------------------------------------------------------------------------
# Parent Orientation (PMO) backend
# ----------------------------------------------------------------------------
BIND_HOST=127.0.0.1
COOKIE_SECRET=replace_with_strong_random_secret
PMO_USER=PMO
PMO_PASS=replace_with_strong_password
SPEAKER_USER=Speaker
SPEAKER_PASS=replace_with_strong_password
SALES_ADMIN_USER=SalesAdmin
SALES_ADMIN_PASS=replace_with_strong_password
ADMIN_USER=admin
