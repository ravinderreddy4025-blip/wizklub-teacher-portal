# ============================================================================
# WizKlub monorepo — single environment file (copy to `.env` at repo root)
#
#   cp .env.example .env
#
# Used by:
#   - backend/technathon
#   - backend/parent-orientation (PMO)
#   - backend/wizklub-testimonials
#   - frontend/wizklub-testimonials (Vite vars)
#   - docker compose
#
# Never commit `.env` — it contains secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Shared / Docker Compose
# ----------------------------------------------------------------------------
NODE_ENV=development
PMO_NODE_ENV=development
TESTIMONIALS_NODE_ENV=development

# One shared Mongo host/cluster URI for all backends
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# Per-app database names on the same Mongo host
TECH_MONGO_DB_NAME=technathon
PMO_MONGO_DB_NAME=parent_orientation
TESTIMONIALS_MONGO_DB_NAME=wizklub_testimonials

# ----------------------------------------------------------------------------
# Technathon backend (port 5000)
# ----------------------------------------------------------------------------
PORT=5000

# AWS S3 storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_UPLOAD_PREFIX=technathon
S3_SIGNED_URL_EXPIRES_SEC=604800
# S3_PUBLIC_BASE_URL=

# SES email notifications
SES_REGION=ap-south-1
SES_FROM_EMAIL=
AWS_NOTIF_ACCESS_KEY=
AWS_NOTIF_SECRET_KEY=
SES_STUDENT_SUBMISSION_TEMPLATE_NAME=WIZ_TECHNATHON_STUDENT_SUBMISSION_CONFIRMATION
WIZKLUB_LOGO_PATH=./assets/email-logo.png
# SES_REPLY_TO_EMAIL=

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# JWT / signed links
JWT_SECRET=
STUDENT_FORM_SECRET=

# Browser origins (Docker gateway on :8080)
ALLOWED_ORIGIN=http://localhost:8080
PUBLIC_WEB_ORIGIN=http://localhost:8080/technathon

# Technathon frontend (Vite local dev; leave empty behind Docker gateway)
VITE_API_URL=http://localhost:5000

# ----------------------------------------------------------------------------
# Parent Orientation / PMO backend (port 8080)
# ----------------------------------------------------------------------------
BIND_HOST=127.0.0.1
COOKIE_SECURE=0
COOKIE_SECRET=
PMO_USER=PMO
PMO_PASS=
SPEAKER_USER=Speaker
SPEAKER_PASS=
SALES_ADMIN_USER=SalesAdmin
SALES_ADMIN_PASS=
ADMIN_USER=admin

# Optional PMO webhook override (required in production when LSQ sync is enabled)
# WIZKLUB_PARENTS_SESSION_WEBHOOK_URL=https://app.srichaitanyacrm.com/apigateway/wizklub_parents_session_webhook/?token=YOUR_TOKEN
# Hours after scheduled end time (IST) before LSQ webhook fires for Completed sessions
LSQ_WEBHOOK_DELAY_HOURS=8
# How often the backend checks for due webhooks (milliseconds)
LSQ_WEBHOOK_POLL_INTERVAL_MS=60000
# Max delivery attempts before marking a session as failed (visible in Mongo only)
LSQ_WEBHOOK_MAX_ATTEMPTS=10
LSQ_WEBHOOK_BATCH_SIZE=25
# Set to 1 to disable LSQ webhook scheduler entirely
LSQ_WEBHOOK_DISABLED=0

# ----------------------------------------------------------------------------
# Wizklub Testimonials backend (port 3001)
# ----------------------------------------------------------------------------
TESTIMONIALS_PORT=3001

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_FOLDER=wizklub
GCS_CREDENTIALS=

# ----------------------------------------------------------------------------
# Wizklub Testimonials frontend (Vite)
# ----------------------------------------------------------------------------
VITE_USE_MOCK=false
# Leave empty when API is served from the same origin (recommended behind /wizklub-testimonials/)
# VITE_API_URL=
# VITE_APP_BASE_PATH=/wizklub-testimonials/
