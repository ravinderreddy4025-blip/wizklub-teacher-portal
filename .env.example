# ============================================================================
# WizKlub monorepo — single environment file (copy to `.env` at repo root)
#
#   cp .env.example .env
#
# Used by:
#   - backend/parent-orientation (PMO)
#   - backend/wizklub-testimonials
#   - backend/inventory (Admin / AM / Dispatch / School)
#   - frontend/wizklub-testimonials (Vite vars)
#   - frontend/inventory (Vite vars)
#   - docker compose
#
# Never commit `.env` — it contains secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Shared / Docker Compose
# ----------------------------------------------------------------------------
NODE_ENV=development
PMO_NODE_ENV=development
TESTIMONIALS_NODE_ENV=development

# One shared Mongo host/cluster URI for all backends.
# Not used by UAT Docker Mongo:
#   docker compose -f docker-compose.yml -f docker-compose.uat.yml up -d --build
# Standalone local Mongo needs retryWrites=false (added automatically by inventory backend if omitted).
MONGO_URI=mongodb://localhost:27017/?directConnection=true&retryWrites=false

# Per-app database names on the same Mongo host
PMO_MONGO_DB_NAME=parent_orientation
TESTIMONIALS_MONGO_DB_NAME=wizklub_testimonials
INVENTORY_MONGO_DB_NAME=wizklub-inventory

# ----------------------------------------------------------------------------
# Parent Orientation / PMO backend (port 8080)
# ----------------------------------------------------------------------------
BIND_HOST=127.0.0.1
COOKIE_SECURE=0
COOKIE_SECRET=
# Parent Orientation (PMO) — Super Admin portal only (env credentials)
ADMIN_USER=admin
SUPERADMIN_PASS=
# PMO portal: WizKlub API login. Speaker / Sales Admin: accounts created by Super Admin in the UI.

# Required in production when LSQ sync is enabled. Do not commit a real token.
# WIZKLUB_PARENTS_SESSION_WEBHOOK_URL=
# Runtime LSQ sync: any session with student_ids is pushed after save (async + retry sweeper).
# LSQ_WEBHOOK_DELAY_HOURS is unused for send timing (kept for health compatibility).
LSQ_WEBHOOK_DELAY_HOURS=8
# How often the retry sweeper checks for pending webhooks (milliseconds)
LSQ_WEBHOOK_POLL_INTERVAL_MS=60000
# Max delivery attempts before marking a session as failed (visible in Mongo only)
LSQ_WEBHOOK_MAX_ATTEMPTS=10
LSQ_WEBHOOK_BATCH_SIZE=25
# Set to 1 to disable LSQ webhook scheduler entirely
LSQ_WEBHOOK_DISABLED=0

# PMO School health: follow-up emails (delegations + action-item reminders)
# Off unless HEALTH_EMAIL_ENABLED=1 AND SMTP_HOST + HEALTH_EMAIL_FROM are set.
HEALTH_EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
HEALTH_EMAIL_FROM=WizKlub School health <health@your-domain>
HEALTH_EMAIL_REPLY_TO=
HEALTH_EMAIL_CC=
PMO_PUBLIC_URL=https://your-admin-host/pmo/
HEALTH_REMINDER_POLL_MS=3600000
# Health snapshot database (written by backend/health-snapshot job)
HEALTH_MONGO_DB_NAME=wizklub_health

# ----------------------------------------------------------------------------
# WizKlub Teachers Portal backend (port 3001)
# ----------------------------------------------------------------------------
TESTIMONIALS_PORT=3001
WIZKLUB_API_BASE_URL=https://api.wizklub.com
# Local overrides (only for local testing of unreleased wizklub_api routes):
# WIZKLUB_API_BASE_URL=http://127.0.0.1:8000
# WIZKLUB_API_BASE_URL=http://host.docker.internal:8000
LMS_BASE_URL=https://lms.wizklub.com
# LMS_API_KEY=
# LMS_API_SECRET=

# Google Cloud Storage (Teachers Portal uploads)
GCS_BUCKET_NAME=
GCS_FOLDER=wizklub
# Service account JSON — minified on one line, OR use base64 instead (easier in Docker):
# GCS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
GCS_CREDENTIALS=
# GCS_CREDENTIALS_BASE64=

# ----------------------------------------------------------------------------
# WizKlub Teachers Portal frontend (Vite)
# ----------------------------------------------------------------------------
VITE_USE_MOCK=false
# Leave empty when API is served from the same origin (recommended behind /wizklub-testimonials/)
# VITE_API_URL=
# Direct wizklub_api calls (assessments, conduct, submit). Host only — no /v1 suffix.
# Production (also the docker-compose default if this line is omitted):
VITE_WIZKLUB_API_BASE_URL=https://api.wizklub.com
# Local Docker + API on host port 8000:
# VITE_WIZKLUB_API_BASE_URL=http://127.0.0.1:8000
# From TESTIMONIALS_BASE_PATH docker-compose build arg
VITE_APP_BASE_PATH=/wizklub-testimonials/
VITE_INVENTORY_API_URL=/wizklub-testimonials/inventory-api

# Inventory frontend (Admin / AM portal — served at /inventory/)
# VITE_INVENTORY_BASE_PATH=/inventory/
# VITE_INVENTORY_API_URL=/inventory/api

# ----------------------------------------------------------------------------
# Inventory / school portal (port 5002, embedded in Teachers Portal)
# ----------------------------------------------------------------------------
INVENTORY_PORT=5002
# Optional full URI override (normally use MONGO_URI + INVENTORY_MONGO_DB_NAME above)
# INVENTORY_MONGODB_URI=mongodb://localhost:27017/wizklub-inventory
JWT_SECRET=
# Optional. Used to encrypt AM passwords so admins can view them. Falls back to JWT_SECRET.
# INVENTORY_CREDENTIAL_KEY=
INTERNAL_BRIDGE_SECRET=
INVENTORY_API_BASE_URL=http://127.0.0.1:5002/api

# Inventory photos/videos (dispatch proof, receipt evidence, audit evidence)
# Required — uploads go to S3 only (no local fallback).
AWS_REGION=
AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=   (or reuse AWS_NOTIF_ACCESS_KEY below)
# AWS_SECRET_ACCESS_KEY=   (or reuse AWS_NOTIF_SECRET_KEY below)
# Optional CloudFront / custom domain (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=
# INVENTORY_S3_PREFIX=inventory
# Set to 1 only if the bucket (or CloudFront) is publicly readable
# INVENTORY_S3_PUBLIC=0
# INVENTORY_S3_SIGNED_URL_TTL=3600

# Inventory email — AM create / AM password reset only (Amazon SES templates)
# SES_TEMPLATE_NAME is not used here: inventory needs two templates, not one.
SES_REGION=
SES_FROM_EMAIL=
AWS_NOTIF_ACCESS_KEY=
AWS_NOTIF_SECRET_KEY=
SES_AM_CREATED_TEMPLATE=WIZ_INVENTORY_AM_CREDENTIALS_TEMPLATE
SES_AM_REGENERATED_TEMPLATE=WIZ_INVENTORY_AM_PASSWORD_RESET_TEMPLATE
# Brand logo — local path for PDFs; email uses FRONTEND_URL/wizklub-logo.png (static file in inventory UI).
WIZKLUB_LOGO_PATH=backend/inventory/assets/wizklub-futurz-logo.png
# Used for AM login links in credential emails and CORS in production. Inventory UI base path included.
FRONTEND_URL=https://admin.wizklub.com/inventory
