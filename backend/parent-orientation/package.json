{
  "name": "parent-orientation-tracker",
  "version": "1.0.0",
  "description": "Parent orientation session tracker with Express, MongoDB, and Excel export",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development node server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "build:toast": "cross-env NODE_PATH=./node_modules esbuild ../../frontend/parent-orientation/src/client/toast-bridge.jsx --bundle --outfile=../../frontend/parent-orientation/public/react-toastify-bundle.js --format=iife --loader:.jsx=jsx --jsx=automatic --minify",
    "build:react": "cross-env NODE_PATH=./node_modules esbuild ../../frontend/parent-orientation/src/main.jsx --bundle --outfile=../../frontend/parent-orientation/public/react-app.js --format=iife --loader:.jsx=jsx --jsx=automatic --minify",
    "build:client": "npm run build:toast && npm run build:react",
    "test": "node test/lsqSync.test.js && node test/lsqWebhookSchedule.test.js && node test/lsqRuntimeDummy.test.js && node test/wizklubApiService.test.js && node test/passwordUtils.test.js && node test/studentIds.test.js && node test/sessionsValidation.test.js && node test/authMiddleware.test.js && node test/targetFulfillment.test.js && node test/apiSecurity.test.js",
    "lint": "node test/lintCheck.js",
    "docker:up": "docker compose -f ../../docker-compose.yml up --build -d",
    "clean": "node clean_excel.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "file-saver": "^2.0.5",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-toastify": "^11.0.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0"
  }
}
